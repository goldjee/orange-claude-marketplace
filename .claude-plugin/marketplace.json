{
    "$schema": "https://www.schemastore.org/claude-code-marketplace.json",
    "name": "orange-claude-marketplace",
    "owner": {
        "name": "Daniel Ch."
    },
    "plugins": [
        {
            "name": "context7",
            "source": {
                "source": "git-subdir",
                "url": "https://github.com/upstash/context7.git",
                "path": "plugins/claude/context7"
            },
            "description": "Up-to-date documentation lookup. Pull version-specific documentation and code examples directly from source repositories into your LLM context.",
            "version": "1.0.2",
            "author": {
                "name": "Upstash"
            },
            "category": "documentation",
            "tags": ["mcp", "docs", "context7"]
        },
        {
            "name": "hr-job-posting-analysis",
            "source": "./plugins/hr-job-posting-analysis",
            "description": "Researches a job posting and judges it as an opportunity: company background, reviews, why the role exists, green and red flags, and CV fit.",
            "version": "1.0.0",
            "author": {
                "name": "Daniel Ch."
            },
            "category": "productivity",
            "tags": ["hiring", "jobs", "research"]
        },
        {
            "name": "news-digest-mcp",
            "source": {
                "source": "url",
                "url": "https://github.com/goldjee/news-digest-mcp.git"
            },
            "description": "A simple MCP server that fetches news from Telegram and RSS sources.",
            "category": "productivity",
            "author": {
                "name": "Daniel Ch."
            },
            "tags": ["mcp", "news", "rss"]
        },
        {
            "name": "sequential-thinking",
            "source": "./plugins/sequential-thinking",
            "description": "Structured step-by-step reasoning through the Sequential Thinking MCP server.",
            "version": "1.0.0",
            "author": {
                "name": "modelcontextprotocol"
            },
            "mcpServers": {
                "sequential-thinking": {
                    "type": "stdio",
                    "command": "npx",
                    "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"]
                }
            },
            "category": "productivity",
            "tags": ["mcp", "reasoning", "thinking"]
        },
        {
            "name": "stop-slop",
            "source": "./plugins/stop-slop",
            "description": "A skill for removing AI tells from prose.",
            "version": "1.0.0",
            "author": {
                "name": "Hardik Pandya"
            }
        }
    ]
}
